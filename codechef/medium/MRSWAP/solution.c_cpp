#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

void solve() {
    int n;
    cin >> n;
    
    int total_size = 2 * n;
    vector<long long> a(total_size);
    for (int i = 0; i < total_size; ++i) {
        cin >> a[i];
    }
    
    long long max_sum = 0;
    // Iterate through the first half and pick the maximum of the pair
    for (int i = 0; i < n; ++i) {
        max_sum += max(a[i], a[total_size - 1 - i]);
    }
    
    cout << max_sum << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    
    return 0;
}
