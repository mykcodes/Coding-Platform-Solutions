#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while (t--) {
	    int N;
	    cin>>N;
	    long long prev = 0;
	    long long ans = 0;
	    for (int i = 1; i<=N;i++) {
	        long long x;
	        cin>>x;
	        if (i%2 == 0) {
	           x = -x; 
	        }
	        ans += abs(x - prev);
	        prev = x;
	    }
	    ans += abs(prev);
	    cout<<ans/2<<'\n';
	}
	return 0;

}
