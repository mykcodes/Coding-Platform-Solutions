#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while (t--) {
	    int N;
	    cin>>N;
	    int cnt[31] = {};
	    for (int i=0; i<N; i++) {
	        int x;
	        cin>>x;
	        int bit = 31 - __builtin_clz(x);
	        cnt[bit]++;
	    }
	    int ans = 1;
	    for (int i=0; i<31; i++) {
	        ans = max(ans,cnt[i]);
	    }
	    cout<<ans<<'\n';
	}
	return 0;

}
