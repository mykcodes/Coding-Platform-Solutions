#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while (t--) {
	    int N,K;
	    cin>>N>>K;
	    vector<long long> A(N);
	    long long total = 0;
	    for (auto &x : A) {
	        cin>>x;
	        total += x;
	    }
	    int len = N-K;
	    long long sum = 0;
	    for (int i=0; i < len; i++) {
	        sum += A[i];
	    }
	    long long maxSum = sum;
	    for (int i =len; i<N; i++) {
	        sum += A[i]-A[i-len];
	        maxSum = max(maxSum, sum);
	    }
	    cout<<maxSum<<'\n';
	}
	return 0;

}
