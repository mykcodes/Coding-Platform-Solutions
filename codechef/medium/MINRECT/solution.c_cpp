#include <bits/stdc++.h>

using namespace std;
void solve () {
    int N,M;
    cin>>N>>M;
    int min_r = N, max_r = -1, min_c = M, max_c =-1;
    for (int i=0; i<N; ++i) {
        string s; cin>>s;
        for (int j=0; j<M; ++j) {
            if (s[j] == '1') {
                min_r = min(min_r, i);
                max_r = min(max_r, i);
                min_c = min(min_c, j);
                max_c = min(max_c, j);
            }
        }
    }
    cout<<(max_r - min_r +1) * (max_c - min_c + 1) << "\n";
}
int main() {
    int t;
    cin>>t;
    while (t--) {
        solve();
    }

}