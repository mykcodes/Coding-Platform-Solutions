#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n;
    cin>>n;
    string a,b;
    cin>>a>>b;
    int aA = count(a.begin(), a.end(), 'a');
    int bB = count(b.begin(), b.end(), 'b');
    if (aA == bB) {
        cout<<"Yes\n";
    } else {
        cout<<"No\n";
    }
}
int main() {
	cin.tie(NULL);
	int t;
	cin>>t;
	while (t--) {
	    solve();
	}
	return 0;

}
